#!/usr/bin/env bash
# tabgroup: open files or URLs in Chrome inside a named tab group.
# Needs the tabgroup browser extension, which does the actual grouping;
# this command tags each address with #tabgroup=<name> and opens it.
set -euo pipefail

VERSION="1.0.0"
COLORS="grey blue red yellow green pink purple cyan orange"

usage() {
  cat <<'EOF'
Usage: tabgroup <group name> <file-or-url>... [options]

Open files or URLs in your browser inside the named tab group.
The group is created if it doesn't exist yet.

Options:
  -c, --color <color>    color for a new group: grey blue red yellow green
                         pink purple cyan orange (existing groups keep theirs)
  -b, --browser <name>   browser to use (default: $TABGROUP_BROWSER, else Chrome)
                         macOS: app name, e.g. "Brave Browser", "Microsoft Edge"
                         Linux: command, e.g. chromium, brave-browser
  -n, --dry-run          print the tagged URLs instead of opening them
  -h, --help             show this help
  -v, --version          show the version

Examples:
  tabgroup "Work Notes" notes/week1.html
  tabgroup "Research" https://arxiv.org/abs/1706.03762 paper.pdf --color purple
EOF
}

die() {
  echo "tabgroup: $*" >&2
  echo "Try 'tabgroup --help'." >&2
  exit 1
}

# Percent-encode bytes outside the unreserved set. $2 lists extra characters to keep.
urlencode() {
  local LC_ALL=C s="$1" keep="${2:-}" out="" c byte hex i
  for ((i = 0; i < ${#s}; i++)); do
    c="${s:i:1}"
    case "$c" in
      [a-zA-Z0-9.~_-]) out+="$c" ;;
      *)
        if [[ -n "$keep" && "$keep" == *"$c"* ]]; then
          out+="$c"
        else
          printf -v byte '%d' "'$c"
          printf -v hex '%%%02X' $((byte & 255)) # some bash versions sign-extend bytes >= 0x80
          out+="$hex"
        fi
        ;;
    esac
  done
  printf '%s' "$out"
}

is_url() {
  [[ "$1" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*:// ]]
}

# Runs in a subshell, so the caller checks that files exist first.
to_url() {
  local target="$1" dir
  if is_url "$target"; then
    printf '%s' "$target"
    return
  fi
  dir="$(cd "$(dirname "$target")" && pwd -P)"
  printf 'file://%s' "$(urlencode "$dir/$(basename "$target")" "/")"
}

tag() {
  local url="$1" extra="tabgroup=$(urlencode "$group")"
  [[ -n "$color" ]] && extra+="&tabcolor=$color"
  if [[ "$url" != *"#"* ]]; then
    printf '%s#%s' "$url" "$extra"
  elif [[ "$url" == *"#" ]]; then
    printf '%s%s' "$url" "$extra"
  else
    printf '%s&%s' "$url" "$extra"
  fi
}

open_macos() {
  local app="${browser:-Google Chrome}"
  osascript - "$app" "$@" >/dev/null <<'APPLESCRIPT'
on run argv
  set appName to item 1 of argv
  tell application appName to activate
  repeat with i from 2 to count of argv
    tell application appName to open location (item i of argv)
  end repeat
end run
APPLESCRIPT
}

open_linux() {
  local bin="$browser" candidate
  if [[ -z "$bin" ]]; then
    for candidate in google-chrome google-chrome-stable chromium chromium-browser brave-browser microsoft-edge; do
      if command -v "$candidate" >/dev/null 2>&1; then bin="$candidate"; break; fi
    done
  fi
  [[ -n "$bin" ]] || die "no Chromium-based browser found; pass --browser <command>"
  nohup "$bin" "$@" >/dev/null 2>&1 &
}

color=""
browser="${TABGROUP_BROWSER:-}"
dry_run=0
args=()
while (($#)); do
  case "$1" in
    -c | --color) [[ $# -ge 2 ]] || die "$1 needs a value"; color="$(tr '[:upper:]' '[:lower:]' <<<"$2")"; shift 2 ;;
    -b | --browser) [[ $# -ge 2 ]] || die "$1 needs a value"; browser="$2"; shift 2 ;;
    -n | --dry-run) dry_run=1; shift ;;
    -h | --help) usage; exit 0 ;;
    -v | --version) echo "tabgroup $VERSION"; exit 0 ;;
    --) shift; args+=("$@"); break ;;
    -*) die "unknown option: $1" ;;
    *) args+=("$1"); shift ;;
  esac
done

((${#args[@]} >= 2)) || die "need a group name and at least one file or URL"
group="$(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' <<<"${args[0]}")"
[[ -n "$group" ]] || die "group name is empty"
if [[ -n "$color" && " $COLORS " != *" $color "* ]]; then
  die "unknown color: $color (choose from: $COLORS)"
fi

urls=()
for target in "${args[@]:1}"; do
  is_url "$target" || [[ -e "$target" ]] || die "no such file: $target"
  url="$(to_url "$target")"
  urls+=("$(tag "$url")")
done

if ((dry_run)); then
  printf '%s\n' "${urls[@]}"
  exit 0
fi

case "$(uname -s)" in
  Darwin) open_macos "${urls[@]}" ;;
  Linux) open_linux "${urls[@]}" ;;
  *) printf '%s\n' "${urls[@]}"; die "opening a browser isn't supported on this OS yet; open the URLs above yourself" ;;
esac
echo "Opened ${#urls[@]} tab(s) in group \"$group\""
